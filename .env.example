# ──────────────────────────────────────────────────────────────
# Supabase (Tokyo / ap-northeast-1 の専用プロジェクトを想定)
# NEXT_PUBLIC_* はクライアントに露出する。anon key までに留めること。
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key はサーバー専用。絶対にクライアントへ出さない。
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────
# OpenAI Whisper（文字起こし。サーバー専用）
# ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# ──────────────────────────────────────────────────────────────
# Anthropic Claude（評価。サーバー専用）
# モデルIDは必要に応じて上書き可能。
# ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# 評価モデル。仕様は Sonnet 系想定。現行 Sonnet の claude-sonnet-4-6 を既定とする。
ANTHROPIC_MODEL=claude-sonnet-4-6

# ──────────────────────────────────────────────────────────────
# 録音セグメント長（秒）。長尺は自動分割して逐次文字起こしする。
# クライアント・サーバー双方で参照するため NEXT_PUBLIC_ にする。
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECORDING_SEGMENT_SEC=300
